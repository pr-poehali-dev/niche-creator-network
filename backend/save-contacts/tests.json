{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "No token returns 401",
      "method": "POST",
      "path": "/",
      "body": {"phone": "+700"},
      "expectedStatus": 401
    },
    {
      "name": "Invalid token returns 401",
      "method": "POST",
      "path": "/",
      "headers": {"X-Auth-Token": "invalid-token-123"},
      "body": {"phone": "+74951234567", "email": "a@b.ru"},
      "expectedStatus": 401
    }
  ]
}