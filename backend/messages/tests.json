    { "name": "Форум: ответ без токена запрещён", "method": "POST", "path": "/", "body": { "action": "forum_reply", "topicId": 1, "authorId": "admin", "authorName": "Администратор", "text": "подделка" }, "expectedStatus": 401, "expectedBody": { "error": "unauthorized" }, "bodyMatcher": "partial" },
    { "name": "Forum list", "method": "GET", "path": "/?kind=forum&category=polygraph", "expectedStatus": 200 },
    { "name": "DM read without token forbidden", "method": "GET", "path": "/?kind=dm&pair=u1:u2", "expectedStatus": 403 },
    { "name": "DM send without token forbidden", "method": "POST", "path": "/", "body": { "action": "dm_send", "pair": "u1:u2", "toId": "u2", "text": "secret" }, "expectedStatus": 403 }
