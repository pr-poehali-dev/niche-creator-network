{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Create without token returns 401",
      "method": "POST",
      "path": "/",
      "body": {"action": "create", "category": "polygraph", "service": "Полиграфолог", "description": "Нужна проверка", "budget": "от 8000", "city": "Москва"},
      "expectedStatus": 401
    },
    {
      "name": "Client list without token returns 401",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    },
    {
      "name": "Provider view without token returns 401",
      "method": "GET",
      "path": "/?view=provider",
      "expectedStatus": 401
    }
  ]
}