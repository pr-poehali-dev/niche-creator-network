    { "name": "Полное резюме с контактами без токена запрещено", "method": "GET", "path": "/?kind=one&id=1", "expectedStatus": 401, "expectedBody": {"error": "unauthorized"}, "bodyMatcher": "partial" },
    { "name": "Сохранение резюме без токена запрещено", "method": "POST", "path": "/", "body": {"action": "save", "position": "Полиграфолог"}, "expectedStatus": 401, "expectedBody": {"error": "unauthorized"}, "bodyMatcher": "partial" }
  ]
