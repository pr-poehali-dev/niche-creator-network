{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Empty body ignored gracefully",
      "method": "POST",
      "path": "/",
      "body": {},
      "expectedStatus": 200,
      "expectedBody": {"ignored": "unknown"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Unknown payload ignored",
      "method": "POST",
      "path": "/",
      "body": {"hello": "world"},
      "expectedStatus": 200,
      "expectedBody": {"ignored": "unknown"},
      "bodyMatcher": "partial"
    },
    {
      "name": "YooKassa non-succeeded ignored",
      "method": "POST",
      "path": "/",
      "body": {"event": "payment.waiting_for_capture", "object": {"id": "1"}},
      "expectedStatus": 200,
      "expectedBody": {"ok": true},
      "bodyMatcher": "partial"
    },
    {
      "name": "YooKassa succeeded rejected without server-side verification",
      "method": "POST",
      "path": "/",
      "body": {"event": "payment.succeeded", "object": {"id": "fake-unverifiable-id", "metadata": {"slug": "morozov", "plan": "premium", "period": "month"}}},
      "expectedStatus": 403,
      "expectedBody": {"error": "verification_failed"},
      "bodyMatcher": "partial"
    },
    {
      "name": "Paddle completed rejected without valid signature",
      "method": "POST",
      "path": "/",
      "body": {"event_type": "transaction.completed", "data": {"id": "fake-txn", "custom_data": {"slug": "semenov", "plan": "pro", "period": "month"}}},
      "expectedStatus": 403,
      "expectedBody": {"error": "bad_signature"},
      "bodyMatcher": "partial"
    }
  ]
}
