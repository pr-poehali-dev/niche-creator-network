{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "No token POST returns 401",
      "method": "POST",
      "path": "/",
      "body": {"legalStatus": "ip"},
      "expectedStatus": 401
    },
    {
      "name": "No token GET returns 401",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    },
    {
      "name": "Invalid token returns 401",
      "method": "GET",
      "path": "/",
      "headers": {"X-Auth-Token": "invalid-token-123"},
      "expectedStatus": 401
    }
  ]
}