{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "No auth token returns 401",
      "method": "POST",
      "path": "/",
      "body": {"fileBase64": "JVBERi0=", "ext": "pdf"},
      "expectedStatus": 401
    },
    {
      "name": "Invalid token returns 401",
      "method": "POST",
      "path": "/",
      "headers": {"X-Auth-Token": "invalid-token-xyz"},
      "body": {"fileBase64": "JVBERi0=", "ext": "pdf"},
      "expectedStatus": 401
    }
  ]
}
