{
  "tests": [
    {
      "name": "CORS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "GET without token returns 401",
      "method": "GET",
      "path": "/",
      "expectedStatus": 401
    },
    {
      "name": "POST without token returns 401",
      "method": "POST",
      "path": "/",
      "body": {"fullName": "Дмитрий Орлов", "phone": "+79990000000", "email": "d.orlov@email.com"},
      "expectedStatus": 401
    },
    {
      "name": "Invalid token returns 401",
      "method": "GET",
      "path": "/",
      "headers": {"X-Auth-Token": "invalid-token-123"},
      "expectedStatus": 401
    }
  ]
}